# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data files
# Ignore everything under data/ by default, except the external subtree (which
# includes external/processed/) so it stays Git-trackable for sharing.
data/*
!data/external/
!data/external/**

# Models (don't commit large model files!)
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
models/checkpoints/*
!models/.gitkeep
!models/README.md

# Results
results/
# Generated run outputs of the KRSA comparison test. `results/` above only covers
# the repo-root results dir, so name this tree explicitly -- it is regenerated by
# tests/compare_pyKinaXe_results_KRSA/compare_pykinaxe_krsa.py and must not be
# committed.
tests/**/results_pykinaxe/
tests/compare_pyKinaXe_results_KRSA/output/
# The pipeline run of tests/run_pykinaxe_on_BN_input/ writes a full results tree
# (one timestamped folder per run, plots included) into its own output/.
tests/run_pykinaxe_on_BN_input/output/
# The pure-R benchmark of validation_paper/run_pamanalyzeR_and_KRSA/ writes one
# signal file per TIFF (1374 of them) plus the KRSA tables into its own output/.
# It is regenerated by run_pamanalyzeR_and_KRSA.R and must not be committed; the
# timings that matter are quoted in that folder's NOTE.txt.
validation_paper/run_pamanalyzeR_and_KRSA/output*/
validation_paper/run_pamanalyzeR_and_KRSA/*.log
# ... but its curated results/ and figures/ ARE the record and must be tracked.
# The repo-wide `results/` and `*.png` rules above would otherwise swallow them
# silently. The directory has to be re-included before its contents, because
# git does not descend into an excluded directory.
!validation_paper/run_pamanalyzeR_and_KRSA/results/
!validation_paper/run_pamanalyzeR_and_KRSA/results/**
experiments/*/logs/
experiments/*/model/
*.png
*.jpg
*.pdf
!docs/img/logo.png
!docs/img/pic.png
!results/.gitkeep

# R (the KRSA reference implementation is run from docs/ during comparisons)
.Rhistory
.RData
.Rproj.user/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Web app runtime
.pykinaxe_web_runtime/
webapp/runtime/

# Environment
.env
.env.local

# The two evidence figures of validation_paper/run_pamanalyzeR_and_KRSA/ are the
# record of a measurement, not generated clutter, so they override the repo-wide
# `*.png` rule. This has to sit AFTER that rule -- in .gitignore the LAST
# matching pattern wins.
!validation_paper/run_pamanalyzeR_and_KRSA/figures/*.png
